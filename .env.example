# Facebook Page Credentials (Chromatis)
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token

# Google Drive Credentials
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Pollinations AI Key (Optional — high-converting Chromatis fallback captions built-in)
POLLINATIONS_API_KEY=your_pollinations_api_key

# Optional Instagram Professional Account ID (Auto-detected if linked to Facebook Page)
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# Optional Pinned Comment Custom Link (Defaults to Chromatis on App Store)
PINNED_COMMENT_LINK=https://apps.apple.com/us/app/chromatis-color-palette/id6773524730
